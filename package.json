{
  "name": "zilero232-profile",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "fetch": "bun src/fetch.ts",
    "build": "bun src/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check",
    "fix": "bun run lint:fix && bun run format",
    "codegen": "graphql-codegen",
    "postinstall": "graphql-codegen --silent"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@octokit/graphql": "^9.0.5",
    "fast-xml-parser": "^5.11.2",
    "nunjucks": "^3.2.4",
    "remeda": "^2.52.0",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@octokit/graphql-schema": "^15.26.1",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@testing-library/dom": "^10.4.2",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^5.0.5",
    "colord": "^2.10.0",
    "eslint": "^10.13.0",
    "graphql": "^16",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
