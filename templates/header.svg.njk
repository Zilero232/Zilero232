{#- fastfetch: logo on the left, `key value` rows and the palette on the right -#}
{% import "_window.njk" as ui %}
{% set p = palette %}
{% set width = 920 %}
{% set line = 18 %}
{% set top = 100 %}
{% set infoX = 380 %}
{% set valueX = 472 %}
{% set logoBottom = top + (header.logo | length - 1) * line %}
{% set rows = header.rows.concat([
  ["Langs", github.languages],
  ["Uptime", "on GitHub since " + github.since],
  ["Stars", github.stars + " across " + github.repos + " public repos"]
]) if github else header.rows %}
{% set desc %}{% for row in rows %}{{ row[0] }}: {{ row[1] }}{{ ". " if not loop.last }}{% endfor %}{% endset %}
{% call ui.window("header", p, fonts, width, logoBottom + 66, header.user + "@" + header.host + ": ~", desc) %}
  {{ ui.prompt(32, 68, "fastfetch") }}

  <text class="logo reveal">
    {% for row in header.logo %}
    <tspan x="32" y="{{ top + loop.index0 * line }}" data-testid="logo-line">{{ row }}</tspan>
    {% endfor %}
  </text>

  <text x="{{ infoX }}" y="{{ top }}" class="reveal" data-testid="host"><tspan class="accent">{{ header.user }}</tspan>@<tspan class="accent">{{ header.host }}</tspan></text>
  <line x1="{{ infoX }}" y1="{{ top + 8 }}" x2="{{ infoX + ((header.user + header.host) | length + 1) * 8.4 }}" y2="{{ top + 8 }}" stroke="{{ p.muted }}" class="reveal" />
  {% for row in rows %}
  <text y="{{ top + (loop.index + 1) * line }}" class="reveal" style="animation-delay: {{ (loop.index * 0.06) | round(2) }}s" data-testid="row"><tspan x="{{ infoX }}" class="key" data-testid="key">{{ row[0] }}</tspan><tspan x="{{ valueX }}" data-testid="value">{{ row[1] }}</tspan></text>
  {% endfor %}

  <g class="reveal" style="animation-delay: {{ ((rows | length + 1) * 0.06) | round(2) }}s">
    {% for color in p.swatches %}
    <rect x="{{ infoX + loop.index0 * 30 }}" y="{{ top + (rows | length + 3) * line - 12 }}" width="26" height="14" rx="3" fill="{{ color }}" data-testid="swatch" />
    {% endfor %}
  </g>

  {{ ui.idle(32, logoBottom + 40) }}
{% endcall %}
