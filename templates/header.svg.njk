{#- fastfetch-style terminal card. Rendered once per palette in profile.yml `theme`. -#}
{% set p = palette %}
{% set width = 920 %}
{% set line = 18 %}
{% set top = 100 %}
{% set infoX = 380 %}
{% set valueX = 472 %}
{% set logoBottom = top + (header.logo | length - 1) * line %}
{% set height = logoBottom + 66 %}
{% set rows = header.rows.concat([
  ["Langs", github.languages],
  ["Uptime", "on GitHub since " + github.since],
  ["Stars", github.stars + " across " + github.repos + " public repos"]
]) if github else header.rows %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ header.user }}@{{ header.host }}: {% for row in rows %}{{ row[0] }} {{ row[1] }}{% if not loop.last %}, {% endif %}{% endfor %}">
  <style>
    text { font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; font-size: 14px; fill: {{ p.fg }}; white-space: pre; font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0; }
    .muted { fill: {{ p.muted }}; }
    .key { fill: {{ p.key }}; font-weight: 700; }
    .accent { fill: {{ p.accent }}; font-weight: 700; }
    .prompt { fill: {{ p.prompt }}; font-weight: 700; }
    .logo { fill: url(#logo); font-weight: 700; }
    .reveal { opacity: 0; animation: reveal 0.45s ease-out forwards; }
    .cursor { fill: {{ p.fg }}; animation: blink 1.1s steps(1) infinite; }
    @keyframes reveal { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .reveal { animation: none; opacity: 1; } .cursor { animation: none; } }
  </style>
  <defs>
    <linearGradient id="logo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{ p.logo[0] }}" />
      <stop offset="1" stop-color="{{ p.logo[1] }}" />
    </linearGradient>
    <clipPath id="window"><rect width="{{ width }}" height="{{ height }}" rx="12" /></clipPath>
  </defs>

  <g clip-path="url(#window)">
    <rect width="{{ width }}" height="{{ height }}" fill="{{ p.bg }}" />
    <rect width="{{ width }}" height="36" fill="{{ p.bar }}" />
    <line x1="0" y1="36" x2="{{ width }}" y2="36" stroke="{{ p.border }}" />
    {% for color in [p.swatches[0], p.swatches[1], p.swatches[3]] %}
    <circle cx="{{ 22 + loop.index0 * 20 }}" cy="18" r="6" fill="{{ color }}" />
    {% endfor %}
    <text x="{{ width / 2 }}" y="23" text-anchor="middle" class="muted">{{ header.user }}@{{ header.host }}: ~</text>
  </g>
  <rect x="0.5" y="0.5" width="{{ width - 1 }}" height="{{ height - 1 }}" rx="12" fill="none" stroke="{{ p.border }}" />

  <text x="32" y="68"><tspan class="prompt">❯</tspan> fastfetch</text>

  <text class="logo reveal" xml:space="preserve">
    {% for row in header.logo %}
    <tspan x="32" y="{{ top + loop.index0 * line }}">{{ row }}</tspan>
    {% endfor %}
  </text>

  <text x="{{ infoX }}" y="{{ top }}" class="reveal"><tspan class="accent">{{ header.user }}</tspan>@<tspan class="accent">{{ header.host }}</tspan></text>
  <line x1="{{ infoX }}" y1="{{ top + 8 }}" x2="{{ infoX + ((header.user + header.host) | length + 1) * 8.4 }}" y2="{{ top + 8 }}" stroke="{{ p.muted }}" class="reveal" />
  {% for row in rows %}
  <text y="{{ top + (loop.index + 1) * line }}" class="reveal" style="animation-delay: {{ (loop.index * 0.06) | round(2) }}s"><tspan x="{{ infoX }}" class="key">{{ row[0] }}</tspan><tspan x="{{ valueX }}">{{ row[1] }}</tspan></text>
  {% endfor %}

  {% set swatchY = top + (rows | length + 3) * line %}
  <g class="reveal" style="animation-delay: {{ ((rows | length + 1) * 0.06) | round(2) }}s">
    {% for color in p.swatches %}
    <rect x="{{ infoX + loop.index0 * 30 }}" y="{{ swatchY - 12 }}" width="26" height="14" rx="3" fill="{{ color }}" />
    {% endfor %}
  </g>

  <text x="32" y="{{ logoBottom + 40 }}"><tspan class="prompt">❯</tspan></text>
  <rect x="50" y="{{ logoBottom + 28 }}" width="9" height="16" class="cursor" />
</svg>
