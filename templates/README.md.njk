<!-- Generated from profile.yml and templates/ by generate.ts. Do not edit by hand. -->
<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/header-dark.svg" />
  <source media="(prefers-color-scheme: light)" srcset="./assets/header-light.svg" />
  <img src="./assets/header-dark.svg" width="100%" alt="fastfetch on {{ header.user }}@{{ header.host }}: {% for row in header.rows %}{{ row[0] }} {{ row[1] }}{% if not loop.last %}, {% endif %}{% endfor %}" />
</picture>

<p align="center"><samp>
{% for link in links %}
  <a href="{{ link.url }}">{{ link.label }}</a>{{ " ·" if not loop.last }}
{% endfor %}
</samp></p>

### {{ name }}

{{ intro }}

### Projects

<table>
{% for pair in projects | batch(2) %}
  <tr>
{% for group in pair %}
    <td valign="top" width="50%">

**{{ group.title }}**

{% for item in group.items %}
- **[{{ item.repo }}](https://github.com/{{ username }}/{{ item.repo }})**{% if github and github.stars[item.repo] >= 10 %} ★ {{ github.stars[item.repo] }}{% endif %}<br /><sub>{{ item.note }}</sub>
{% endfor %}

</td>
{% endfor %}
  </tr>
{% endfor %}
</table>

### Now

<table>
{% for item in now %}
  <tr>
    <td><samp>{{ item.label }}</samp></td>
    <td>{{ item.text }}</td>
  </tr>
{% endfor %}
</table>

{% if github %}
### GitHub

<samp>Since {{ github.since }} · {{ github.repos }} public repos · ★ {{ github.totalStars }} · {{ github.pullRequests }} pull requests · {{ github.contributions }} contributions in the last year</samp>

{% endif %}
<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/snake-dark.svg" />
  <source media="(prefers-color-scheme: light)" srcset="./assets/snake-light.svg" />
  <img src="./assets/snake-dark.svg" width="100%" alt="Snake eating my contribution graph" />
</picture>

<p align="center"><sub>Generated from <a href="./profile.yml">profile.yml</a> by a GitHub Action, refreshed daily.</sub></p>
