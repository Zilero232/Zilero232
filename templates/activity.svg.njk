{#- `git log --oneline` across public repos: hash, repo, subject and age on one line -#}
{% import "_window.njk" as ui %}
{% set p = palette %}
{% set cell = 8.4 %}
{% set step = 22 %}
{% set top = 104 %}
{% set columns = { hash: 32, repo: 32 + 9 * cell, subject: 32 + 27 * cell } %}
{% set types = { feat: p.swatches[3], fix: p.swatches[0], docs: p.swatches[5], test: p.swatches[2], refactor: p.swatches[6], perf: p.swatches[1] } %}
{% set count = github.commits | length %}
{% set height = top + (count - 1) * step + 50 %}
{% set desc %}{{ count }} recent commits. {% for c in github.commits %}{{ c.repo }}, {{ c.age }}: {{ c.type }}{{ c.rest }}{{ ". " if not loop.last }}{% endfor %}{% endset %}
{% call ui.window("activity", p, fonts, card.width, height, "~/code", desc) %}
  {{ ui.prompt(32, 68, "git log --oneline --author=" + username + " -" + count) }}

  {% for c in github.commits %}
  <text y="{{ top + loop.index0 * step }}" class="reveal" style="animation-delay: {{ (loop.index * 0.06) | round(2) }}s" data-testid="commit"><tspan x="{{ columns.hash }}" fill="{{ p.swatches[2] }}" data-testid="hash">{{ c.hash }}</tspan><tspan x="{{ columns.repo }}" class="key" data-testid="repo">{{ c.repo }}</tspan><tspan x="{{ columns.subject }}" data-testid="subject">{% if c.type %}<tspan fill="{{ types[c.type] or p.muted }}" class="bold" data-testid="type">{{ c.type }}</tspan>{% endif %}{{ c.rest }}</tspan></text>
  <text x="{{ card.width - 32 }}" y="{{ top + loop.index0 * step }}" text-anchor="end" class="muted reveal" style="animation-delay: {{ (loop.index * 0.06) | round(2) }}s" data-testid="age">{{ c.age }}</text>
  {% endfor %}

  {{ ui.idle(32, height - 22) }}
{% endcall %}
