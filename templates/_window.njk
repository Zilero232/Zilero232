{#- Terminal window chrome shared by every SVG card. The body goes in the `call` block.
    Ids are prefixed with the card name so cards never clash when inlined together. -#}
{% macro window(id, p, fonts, width, height, title, desc) %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" xml:space="preserve" role="img" aria-labelledby="{{ id }}-title {{ id }}-desc">
  <title id="{{ id }}-title">{{ title }}</title>
  <desc id="{{ id }}-desc">{{ desc }}</desc>
  <style>
    {% if fonts %}
    @font-face { font-family: "JetBrains Mono"; font-weight: 400; src: url("{{ fonts.regular }}") format("woff2"); }
    @font-face { font-family: "JetBrains Mono"; font-weight: 700; src: url("{{ fonts.bold }}") format("woff2"); }
    {% endif %}
    text { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; font-size: 14px; fill: {{ p.fg }}; white-space: pre; font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0; }
    .muted { fill: {{ p.muted }}; }
    .key { fill: {{ p.key }}; font-weight: 700; }
    .accent { fill: {{ p.accent }}; font-weight: 700; }
    .prompt { fill: {{ p.prompt }}; font-weight: 700; }
    .bold { font-weight: 700; }
    .logo { fill: url(#{{ id }}-logo); font-weight: 700; }
    .reveal { opacity: 0; animation: reveal 0.45s ease-out forwards; }
    .cursor { fill: {{ p.fg }}; animation: blink 1.1s steps(1) infinite; }
    @keyframes reveal { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .reveal { animation: none; opacity: 1; } .cursor { animation: none; } }
  </style>
  <defs>
    <linearGradient id="{{ id }}-logo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{ p.logo[0] }}" />
      <stop offset="1" stop-color="{{ p.logo[1] }}" />
    </linearGradient>
    <clipPath id="{{ id }}-window"><rect width="{{ width }}" height="{{ height }}" rx="12" /></clipPath>
  </defs>

  <g clip-path="url(#{{ id }}-window)">
    <rect width="{{ width }}" height="{{ height }}" fill="{{ p.bg }}" />
    <rect width="{{ width }}" height="36" fill="{{ p.bar }}" />
    <line x1="0" y1="36" x2="{{ width }}" y2="36" stroke="{{ p.border }}" />
    {% for color in [p.swatches[0], p.swatches[1], p.swatches[3]] %}
    <circle cx="{{ 22 + loop.index0 * 20 }}" cy="18" r="6" fill="{{ color }}" />
    {% endfor %}
    <text x="{{ width / 2 }}" y="23" text-anchor="middle" class="muted" data-testid="title">{{ title }}</text>
  </g>
  <rect x="0.5" y="0.5" width="{{ width - 1 }}" height="{{ height - 1 }}" rx="12" fill="none" stroke="{{ p.border }}" />

{{ caller() }}
</svg>
{% endmacro %}

{% macro prompt(x, y, command) %}
<text x="{{ x }}" y="{{ y }}" data-testid="prompt"><tspan class="prompt">❯</tspan> {{ command }}</text>
{% endmacro %}

{#- An empty prompt with a blinking cursor closes the session -#}
{% macro idle(x, y) %}
<text x="{{ x }}" y="{{ y }}"><tspan class="prompt">❯</tspan></text>
<rect x="{{ x + 18 }}" y="{{ y - 12 }}" width="9" height="16" class="cursor" />
{% endmacro %}
