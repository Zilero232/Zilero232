{#- `tree --charset=ascii ~/stack`: one directory per area, the tools as its files -#}
{% import "_window.njk" as ui %}
{% set p = palette %}
{% set count = stack | length %}
{% set desc %}{% for area, tools in stack %}{{ area }}: {{ tools | join(", ") }}{{ ". " if not loop.last }}{% endfor %}{% endset %}
{% call ui.window("stack", p, fonts, pane.width, pane.height, "~/stack", desc) %}
  {{ ui.prompt(24, 68, "tree ~/stack") }}

  <text x="24" y="104" class="reveal bold">~/stack</text>
  {% for area, tools in stack %}
  <text x="24" y="{{ 104 + loop.index * pane.line }}" class="reveal" style="animation-delay: {{ (loop.index * 0.08) | round(2) }}s" data-testid="area"><tspan class="muted" data-testid="branch">{{ "`-- " if loop.last else "|-- " }}</tspan><tspan fill="{{ p.swatches[loop.index0 % (p.swatches | length)] }}" class="bold" data-testid="name">{{ area }}</tspan><tspan x="{{ 24 + 13 * 8.4 }}" data-testid="tools">{{ tools | join(" · ") }}</tspan></text>
  {% endfor %}

  <text x="24" y="{{ 104 + (count + 2) * pane.line }}" class="muted reveal" style="animation-delay: {{ ((count + 1) * 0.08) | round(2) }}s" data-testid="summary">{{ count }} directories, {{ stackTools }} files</text>

  {{ ui.idle(24, pane.height - 22) }}
{% endcall %}
